* {
  box-sizing: border-box;
}

:root {
  --bg: #11100e;
  --panel: #191714;
  --text: #f4eee5;
  --muted: #b8aea1;
  --accent: #e58b42;
  --line: rgba(244, 238, 229, 0.14);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

.nav {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 6%;
  background: rgba(17, 16, 14, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}

.logo {
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.nav nav {
  display: flex;
  gap: 24px;
  color: var(--muted);
  font-family: Arial, sans-serif;
  font-size: 0.9rem;
}

.nav-btn,
.primary,
.secondary {
  border: 0;
  border-radius: 999px;
  padding: 12px 20px;
  cursor: pointer;
  font-weight: 700;
  font-size: 0.9rem;
}

.nav-btn,
.primary {
  background: var(--accent);
  color: #1b120b;
}

.secondary {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
}

.hero {
  min-height: 78vh;
  display: grid;
  align-items: end;
  padding: 10% 6% 8%;
  background:
    radial-gradient(
      circle at 75% 35%,
      rgba(229, 139, 66, 0.2),
      transparent 30%
    ),
    linear-gradient(135deg, #17130f, #0e0d0c 60%);
}

.hero-content {
  max-width: 760px;
}

.eyebrow {
  margin: 0 0 16px;
  color: var(--accent);
  font: 700 0.75rem/1.2 Arial, sans-serif;
  letter-spacing: 0.16em;
}

h1,
h2,
h3 {
  line-height: 1.05;
  margin: 0;
}

h1 {
  font-size: clamp(3rem, 8vw, 7rem);
  letter-spacing: -0.045em;
}

h1 span {
  color: var(--accent);
}

.hero-copy {
  max-width: 620px;
  margin: 28px 0;
  color: var(--muted);
  font: 1.05rem/1.7 Arial, sans-serif;
}

.actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.section {
  padding: 100px 6%;
}

.section-heading {
  margin-bottom: 44px;
}

h2 {
  font-size: clamp(2.5rem, 5vw, 4.5rem);
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.dish {
  padding: 30px;
  min-height: 260px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 20px;
}

.dish.featured {
  transform: translateY(-18px);
}

